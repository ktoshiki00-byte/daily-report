# LINE Developers コンソールから取得
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# Google Cloud コンソールで作成したサービスアカウントのJSONをそのまま貼る
# 例: {"type":"service_account","project_id":"...","private_key_id":"...",...}
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"YOUR_PROJECT","private_key_id":"KEY_ID","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"YOUR_SA@YOUR_PROJECT.iam.gserviceaccount.com","client_id":"CLIENT_ID","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}

# GoogleスプレッドシートのID（URLの /d/〇〇/ 部分）
GOOGLE_SHEET_ID=your_google_sheet_id_here
